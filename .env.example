# Local development. Copy to .env.local; `docker compose -f compose.dev.yaml
# up -d` starts PostgreSQL 18 and a Keycloak with test users (password:
# handbook-dev; the list is in compose.dev.yaml).
# Every variable is described in docs/configuration.md.

# The web app's development server (npm run dev) on port 5173 passes /api,
# /mcp, /oauth, /.well-known, /files and /s/*.md to the server on port 3000;
# sign in at http://localhost:5173.
APP_URL=http://localhost:5173
DATABASE_URL=postgres://handbook:handbook@localhost:55450/handbook
# Development only; production: openssl rand -base64 32
AUTH_SECRET=development-secret-development-secret

OIDC_ISSUER=http://localhost:8104/realms/handbook
OIDC_CLIENT_ID=handbook
OIDC_CLIENT_SECRET=handbook-dev-client-secret
OIDC_PROVIDER_NAME=Keycloak

# Always admins; set up spaces and editors in the app.
ADMIN_EMAILS=ada@example.org
# Only members of /staff (and its subgroups) may sign in; gina@example.org may not.
ACCESS_GROUPS=/staff
SEARCH_LANGUAGES=english,german

NODE_ENV=development
RUN_MIGRATIONS=true
# Development only: lets MCP clients on localhost register with a client metadata document.
OAUTH_ALLOW_PRIVATE_CLIENT_URLS=true

# Production with compose.yaml: new secrets, URLs and sign-in values above,
# and optionally the image to run (docs/deployment.md): latest (default) or
# sha-<commit>.
# HANDBOOK_IMAGE_TAG=latest
